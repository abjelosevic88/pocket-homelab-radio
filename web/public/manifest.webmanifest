{
  "name": "Pocket Radio",
  "short_name": "Radio",
  "description": "Internet radio and stations of your own: stations from around the world, the song that is playing, the songs you heard, and channels from your own music library that play like real radio.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#0b7285",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Listen",
      "url": "/"
    },
    {
      "name": "Find stations",
      "url": "/find"
    },
    {
      "name": "Your channels",
      "url": "/channels"
    },
    {
      "name": "Add a station",
      "url": "/?add=1"
    }
  ]
}
